{
  "name": "institutional-defi-platform",
  "version": "1.0.0",
  "description": "Production-grade institutional DeFi staking, investment, and swap platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "dev:frontend": "cd . && next dev",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:ai": "cd ai-engine && python app.py",
    "build": "concurrently \"npm run build:frontend\" \"npm run build:backend\"",
    "build:frontend": "next build",
    "build:backend": "cd backend && npm run build",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\" \"npm run start:ai\"",
    "start:frontend": "next start",
    "start:backend": "cd backend && npm run start",
    "start:ai": "cd ai-engine && python app.py",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next": "^14.2.3",
    "typescript": "^5.4.5",
    "tailwindcss": "^3.4.3",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slot": "^2.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.408.0",
    "tailwind-merge": "^2.4.0",
    "zustand": "^4.5.1",
    "@tanstack/react-query": "^5.39.1",
    "recharts": "^2.12.7",
    "@tremor/react": "^3.17.0",
    "framer-motion": "^10.16.18",
    "@supabase/supabase-js": "^2.43.4",
    "wagmi": "^2.5.8",
    "viem": "^2.8.13",
    "@rainbow-me/rainbowkit": "^2.1.3",
    "@solana/web3.js": "^1.92.3",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@jup-ag/react-hook": "^2.15.8",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "concurrently": "^8.2.2"
  }
}
